# ─── Shopify App Credentials ─────────────────────────────────────────────────
# Obtain from your Shopify Partner Dashboard → Apps → your app → API credentials
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret

# ─── App URL ──────────────────────────────────────────────────────────────────
# Public HTTPS URL of this app (use ngrok or a real domain in development)
SHOPIFY_APP_URL=https://your-app.example.com

# ─── Scopes ───────────────────────────────────────────────────────────────────
# Comma-separated list of Shopify access scopes your plugin requires
# Full scope reference: https://shopify.dev/docs/api/usage/access-scopes
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_inventory,write_inventory,read_fulfillments,write_fulfillments,read_shipping,read_customers,read_analytics

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Session Storage ──────────────────────────────────────────────────────────
# SQLite DB path for persisting Shopify sessions (relative to project root)
SESSION_DB_PATH=sessions.db

# ─── Webhook Secret ───────────────────────────────────────────────────────────
# Used to verify incoming Shopify webhook payloads (same as SHOPIFY_API_SECRET
# unless you set a separate secret in the Partner Dashboard)
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret
