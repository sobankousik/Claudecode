{
  "name": "shopify-plugin-integration",
  "version": "1.0.0",
  "description": "Shopify plugin integration — connects /plugin to Shopify store and marketplace APIs",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "account1": "cp .env.account1 .env && nodemon server.js",
    "account2": "cp .env.account2 .env && nodemon server.js"
  },
  "dependencies": {
    "@shopify/shopify-api": "^11.0.0",
    "@shopify/shopify-app-express": "^5.0.0",
